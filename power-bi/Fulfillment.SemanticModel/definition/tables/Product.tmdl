table 'Product'

	column 'SKU'
		dataType: string
		summarizeBy: none
		sourceColumn: SKU

	column 'Category'
		dataType: string
		summarizeBy: none
		sourceColumn: Category

	column 'Unit Cost'
		dataType: decimal
		summarizeBy: none
		sourceColumn: Unit Cost

	partition 'Product' = m
		mode: import
		source =
			let
				Payload = Text.Combine({
						""
				}, ""),
				Source = Binary.Decompress(Binary.FromText(Payload, BinaryEncoding.Base64), Compression.Deflate),
				Rows = Csv.Document(Source, [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Headers = Table.PromoteHeaders(Rows, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Headers, {{"SKU", type text}, {"Category", type text}, {"Unit Cost", Currency.Type}}, "en-US")
			in
				Typed

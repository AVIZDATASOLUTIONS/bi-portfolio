table 'Order Lines'

	column 'Line ID'
		dataType: int64
		summarizeBy: none
		sourceColumn: Line ID

	column 'Order Date'
		dataType: dateTime
		summarizeBy: none
		sourceColumn: Order Date
		formatString: yyyy-MM-dd

	column 'Promise Date'
		dataType: dateTime
		summarizeBy: none
		sourceColumn: Promise Date
		formatString: yyyy-MM-dd

	column 'Warehouse'
		dataType: string
		summarizeBy: none
		sourceColumn: Warehouse

	column 'SKU'
		dataType: string
		summarizeBy: none
		sourceColumn: SKU

	column 'Ordered Units'
		dataType: int64
		summarizeBy: none
		sourceColumn: Ordered Units

	column 'Shipped Units'
		dataType: int64
		summarizeBy: none
		sourceColumn: Shipped Units

	column 'On Time Units'
		dataType: int64
		summarizeBy: none
		sourceColumn: On Time Units

	column 'Is OTIF'
		dataType: boolean
		summarizeBy: none
		sourceColumn: Is OTIF

	column 'Is Mature'
		dataType: boolean
		summarizeBy: none
		sourceColumn: Is Mature

	column 'Missed Units'
		dataType: int64
		summarizeBy: none
		sourceColumn: Missed Units

	measure 'Matured Lines' = CALCULATE(COUNTROWS('Order Lines'), 'Order Lines'[Is Mature] = TRUE())
		formatString: #,0

	measure 'OTIF Lines' = CALCULATE(COUNTROWS('Order Lines'), 'Order Lines'[Is Mature] = TRUE(), 'Order Lines'[Is OTIF] = TRUE())
		formatString: #,0

	measure 'Line OTIF' = DIVIDE(COALESCE([OTIF Lines],0), [Matured Lines])
		formatString: 0.0%

	measure 'Matured Demand Units' = CALCULATE(SUM('Order Lines'[Ordered Units]), 'Order Lines'[Is Mature] = TRUE())
		formatString: #,0

	measure 'Matured On Time Units' = CALCULATE(SUM('Order Lines'[On Time Units]), 'Order Lines'[Is Mature] = TRUE())
		formatString: #,0

	measure 'On Time Unit Fill' = DIVIDE([Matured On Time Units], [Matured Demand Units])
		formatString: 0.0%

	measure 'Missed Promise Units' = SUM('Order Lines'[Missed Units])
		formatString: #,0

	measure 'OTIF Prior Week' = CALCULATE([Line OTIF], DATEADD('Calendar'[Date], -7, DAY))
		formatString: 0.0%

	measure 'OTIF Week over Week' = [Line OTIF] - [OTIF Prior Week]
		formatString: 0.0%

	partition 'Order Lines' = m
		mode: import
		source =
			let
				Payload = Text.Combine({
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						""
				}, ""),
				Source = Binary.Decompress(Binary.FromText(Payload, BinaryEncoding.Base64), Compression.Deflate),
				Rows = Csv.Document(Source, [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Headers = Table.PromoteHeaders(Rows, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Headers, {{"Line ID", Int64.Type}, {"Order Date", type date}, {"Promise Date", type date}, {"Warehouse", type text}, {"SKU", type text}, {"Ordered Units", Int64.Type}, {"Shipped Units", Int64.Type}, {"On Time Units", Int64.Type}, {"Is OTIF", type logical}, {"Is Mature", type logical}, {"Missed Units", Int64.Type}}, "en-US")
			in
				Typed

table 'Inventory'

	column 'Inventory Date'
		dataType: dateTime
		summarizeBy: none
		sourceColumn: Inventory Date
		formatString: yyyy-MM-dd

	column 'Warehouse'
		dataType: string
		summarizeBy: none
		sourceColumn: Warehouse

	column 'SKU'
		dataType: string
		summarizeBy: none
		sourceColumn: SKU

	column 'Opening Units'
		dataType: int64
		summarizeBy: none
		sourceColumn: Opening Units

	column 'Received Units'
		dataType: int64
		summarizeBy: none
		sourceColumn: Received Units

	column 'Shipped Units'
		dataType: int64
		summarizeBy: none
		sourceColumn: Shipped Units

	column 'Closing Units'
		dataType: int64
		summarizeBy: none
		sourceColumn: Closing Units

	column 'Closing Value'
		dataType: decimal
		summarizeBy: none
		sourceColumn: Closing Value

	measure 'Ending Inventory Value' = VAR AsOfDate = MAX('Inventory'[Inventory Date]) RETURN CALCULATE(SUM('Inventory'[Closing Value]), KEEPFILTERS('Calendar'[Date] = AsOfDate))
		formatString: $#,0

	measure 'Ending Stock Units' = VAR AsOfDate = MAX('Inventory'[Inventory Date]) RETURN CALCULATE(SUM('Inventory'[Closing Units]), KEEPFILTERS('Calendar'[Date] = AsOfDate))
		formatString: #,0

	partition 'Inventory' = m
		mode: import
		source =
			let
				Payload = Text.Combine({
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						"",
						""
				}, ""),
				Source = Binary.Decompress(Binary.FromText(Payload, BinaryEncoding.Base64), Compression.Deflate),
				Rows = Csv.Document(Source, [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Headers = Table.PromoteHeaders(Rows, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Headers, {{"Inventory Date", type date}, {"Warehouse", type text}, {"SKU", type text}, {"Opening Units", Int64.Type}, {"Received Units", Int64.Type}, {"Shipped Units", Int64.Type}, {"Closing Units", Int64.Type}, {"Closing Value", Currency.Type}}, "en-US")
			in
				Typed

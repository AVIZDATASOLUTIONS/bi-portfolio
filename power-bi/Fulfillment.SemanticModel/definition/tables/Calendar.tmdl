table 'Calendar'

	column 'Date'
		dataType: dateTime
		summarizeBy: none
		sourceColumn: Date
		formatString: yyyy-MM-dd
		isKey

	column 'Week Beginning'
		dataType: dateTime
		summarizeBy: none
		sourceColumn: Week Beginning
		formatString: yyyy-MM-dd

	partition 'Calendar' = m
		mode: import
		source =
			let
				Payload = Text.Combine({
						""
				}, ""),
				Source = Binary.Decompress(Binary.FromText(Payload, BinaryEncoding.Base64), Compression.Deflate),
				Rows = Csv.Document(Source, [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Headers = Table.PromoteHeaders(Rows, [PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Headers, {{"Date", type date}, {"Week Beginning", type date}}, "en-US")
			in
				Typed
